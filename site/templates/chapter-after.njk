{% if page.unit_number %}
{% if page.reference_author and page.reference_title %}
<section class="chapter-reference" aria-labelledby="chapter-reference-title">
  <h2 id="chapter-reference-title">References</h2>
  <p>{{ page.reference_author }}. <cite>{{ page.reference_title }}</cite>. {{ page.unit_label }} {{ page.unit_number }}: {{ page.unit_title }}.</p>
</section>
{% endif %}

{% if page.tutorial_path %}
<section class="learning-related" aria-label="Tutorial exercises">
  <span>Tutorial Exercises</span>
  <a href="{{ url_for(page.tutorial_path) }}">{{ page.tutorial_title }}</a>
</section>
{% endif %}

{% if page.parent_unit_path %}
<section class="learning-related" aria-label="Parent week">
  <span>Parent Week</span>
  <a href="{{ url_for(page.parent_unit_path) }}">← Week {{ page.parent_unit_number }} · {{ page.parent_unit_title }}</a>
</section>
{% endif %}

<nav class="chapter-navigation" aria-label="{{ page.unit_label }} navigation">
  <div class="chapter-navigation__previous">
    <span>Previous {{ page.unit_label }}</span>
    {% if page.prev_unit_path %}
      <a href="{{ url_for(page.prev_unit_path) }}">{{ page.prev_unit_number }} {{ page.prev_unit_title }}</a>
    {% else %}
      <strong aria-disabled="true">—</strong>
    {% endif %}
  </div>
  <div class="chapter-navigation__next">
    <span>Next {{ page.unit_label }}</span>
    {% if page.next_unit_path %}
      <a href="{{ url_for(page.next_unit_path) }}">{{ page.next_unit_number }} {{ page.next_unit_title }}</a>
    {% else %}
      <strong aria-disabled="true">—</strong>
    {% endif %}
  </div>
</nav>
{% endif %}
